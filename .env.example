# Copy this file to .env.local and fill in real values.
# Note: this starter reads IDs from hardcoded constants in app/layout.tsx and
# data/cities/*.json instead of env vars, to match the plan's "no backend,
# nothing to break during a live demo" approach. This file exists so the
# real placeholders the team needs are documented in one place.

# app/layout.tsx -> GA_MEASUREMENT_ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# app/layout.tsx -> BOTPRESS_BOT_ID
NEXT_PUBLIC_BOTPRESS_BOT_ID=YOUR_BOTPRESS_BOT_ID

# data/cities/*.json -> healthcare.maps_embed_url / community.maps_embed_url (per city)
GOOGLE_MAPS_EMBED_API_KEY=YOUR_GOOGLE_MAPS_EMBED_API_KEY

# components/FeedbackForm.tsx -> TALLY_EMBED_URL
TALLY_FORM_URL=https://tally.so/embed/YOUR_FORM_ID
