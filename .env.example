# Copy this file to .env.local for local work, or add the same names in
# Vercel -> Project -> Settings -> Environment Variables (then redeploy).
# Every value is optional: with none set, the app still works and saves
# progress on the visitor's own device only.

# --- Accounts (free Supabase project; see README -> "Turn on accounts") ---
# Supabase -> Project Settings -> API. Both values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Analytics ---
# Google Analytics 4 measurement ID (format G-XXXXXXXXXX). Analytics stays off if empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feedback form (set ONE; the form is hidden if both are empty) ---
# Option 1: a Tally.so embed URL, e.g. https://tally.so/embed/abc123
NEXT_PUBLIC_TALLY_EMBED_URL=
# Option 2: an email address; the form opens the visitor's mail app pre-filled.
NEXT_PUBLIC_FEEDBACK_EMAIL=
